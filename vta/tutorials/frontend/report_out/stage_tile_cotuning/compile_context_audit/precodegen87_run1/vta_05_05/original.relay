#[version = "0.0.5"]
def @main(%data0: Tensor[(1, 64, 56, 56), float32], %resnetv10_stage2_conv0_weight: Tensor[(128, 64, 3, 3), float32], %resnetv10_stage2_batchnorm0_gamma: Tensor[(128), float32], %resnetv10_stage2_batchnorm0_beta: Tensor[(128), float32], %resnetv10_stage2_batchnorm0_running_mean: Tensor[(128), float32], %resnetv10_stage2_batchnorm0_running_var: Tensor[(128), float32], %resnetv10_stage2_conv1_weight: Tensor[(128, 128, 3, 3), float32], %resnetv10_stage2_batchnorm1_gamma: Tensor[(128), float32], %resnetv10_stage2_batchnorm1_beta: Tensor[(128), float32], %resnetv10_stage2_batchnorm1_running_mean: Tensor[(128), float32], %resnetv10_stage2_batchnorm1_running_var: Tensor[(128), float32]) {
  %0 = nn.conv2d(%data0, %resnetv10_stage2_conv0_weight, strides=[2, 2], padding=[1, 1, 1, 1], channels=128, kernel_size=[3, 3]);
  %1 = nn.batch_norm(%0, %resnetv10_stage2_batchnorm0_gamma, %resnetv10_stage2_batchnorm0_beta, %resnetv10_stage2_batchnorm0_running_mean, %resnetv10_stage2_batchnorm0_running_var);
  %2 = %1.0;
  %3 = nn.relu(%2);
  %4 = nn.conv2d(%3, %resnetv10_stage2_conv1_weight, padding=[1, 1, 1, 1], channels=128, kernel_size=[3, 3]);
  %5 = nn.batch_norm(%4, %resnetv10_stage2_batchnorm1_gamma, %resnetv10_stage2_batchnorm1_beta, %resnetv10_stage2_batchnorm1_running_mean, %resnetv10_stage2_batchnorm1_running_var);
  %6 = %5.0;
  (%6, %data0)
}
