#[version = "0.0.5"]
def @main(%data0: Tensor[(1, 64, 56, 56), float32], %resnetv10_stage1_conv0_weight: Tensor[(64, 64, 3, 3), float32], %resnetv10_stage1_batchnorm0_gamma: Tensor[(64), float32], %resnetv10_stage1_batchnorm0_beta: Tensor[(64), float32], %resnetv10_stage1_batchnorm0_running_mean: Tensor[(64), float32], %resnetv10_stage1_batchnorm0_running_var: Tensor[(64), float32], %resnetv10_stage1_conv1_weight: Tensor[(64, 64, 3, 3), float32], %resnetv10_stage1_batchnorm1_gamma: Tensor[(64), float32], %resnetv10_stage1_batchnorm1_beta: Tensor[(64), float32], %resnetv10_stage1_batchnorm1_running_mean: Tensor[(64), float32], %resnetv10_stage1_batchnorm1_running_var: Tensor[(64), float32]) {
  %0 = nn.conv2d(%data0, %resnetv10_stage1_conv0_weight, padding=[1, 1, 1, 1], channels=64, kernel_size=[3, 3]);
  %1 = nn.batch_norm(%0, %resnetv10_stage1_batchnorm0_gamma, %resnetv10_stage1_batchnorm0_beta, %resnetv10_stage1_batchnorm0_running_mean, %resnetv10_stage1_batchnorm0_running_var);
  %2 = %1.0;
  %3 = nn.relu(%2);
  %4 = nn.conv2d(%3, %resnetv10_stage1_conv1_weight, padding=[1, 1, 1, 1], channels=64, kernel_size=[3, 3]);
  %5 = nn.batch_norm(%4, %resnetv10_stage1_batchnorm1_gamma, %resnetv10_stage1_batchnorm1_beta, %resnetv10_stage1_batchnorm1_running_mean, %resnetv10_stage1_batchnorm1_running_var);
  %6 = %5.0;
  %7 = add(%6, %data0);
  nn.relu(%7)
}
