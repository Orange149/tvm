  %15 = %14.0;
  %16 = add(%15, %8);
  %17 = nn.relu(%16);
  %18 = nn.conv2d(%17, %resnetv10_stage2_conv0_weight, strides=[2, 2], padding=[1, 1, 1, 1], channels=128, kernel_size=[3, 3]);
  %19 = nn.batch_norm(%18, %resnetv10_stage2_batchnorm0_gamma, %resnetv10_stage2_batchnorm0_beta, %resnetv10_stage2_batchnorm0_running_mean, %resnetv10_stage2_batchnorm0_running_var);
  %20 = %19.0;
  %21 = nn.relu(%20);
  %22 = nn.conv2d(%21, %resnetv10_stage2_conv1_weight, padding=[1, 1, 1, 1], channels=128, kernel_size=[3, 3]);
